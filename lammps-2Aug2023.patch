+  gG[0] = gG[1] = gG[2] = 0;
+	xplus = (x+1)%gnx;
+	xminus = (gnx + x -1)%gnx;
+	yplus = (y+1)%gny;
+	yminus = (gny + y -1)%gny;
+	zplus = (z+1)%gnz;
+	zminus = (gnz + z -1)%gnz;
