+double FixGridForce::gridValue(double *gvin, int x, int y, int z) {
+  int gnx = domain->grid->gnx;
+  int gny = domain->grid->gny;
+  int gnz = domain->grid->gnz;
+  double gValue = 0;
+
+  gValue = gvin[(z % gnz) + (y % gny) * gnz + (x % gnx) * gnz * gny];
+
+  return gValue;
+}
