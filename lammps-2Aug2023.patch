+Grid::~Grid() {
+  memory->destroy(atomns);
+  memory->destroy(basis);
+  memory->destroy(gvin);
+  memory->destroy(gvout);
+  memory->destroy(gvout_all);
+  memory->destroy(cvin);
+}
